# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing and secrets — never commit these. A leaked upload key cannot be rotated
# on Play without losing the app listing.
*.jks
*.keystore
key.properties
android/key.properties
.env
.env.*

# Machine-specific SDK paths
android/local.properties

# Nested Gradle build dirs. android/build.gradle.kts redirects buildDir to the
# root build/ (covered above), so Flutter's own flow never creates these — but a
# direct ./gradlew invocation or Android Studio still can, and /build/ is
# root-anchored so it would not catch them.
**/build/

# Firebase config: carries project identifiers and API keys. Garfin uses no
# Firebase and SECURITY.md claims no telemetry — if that ever changes
# deliberately, revisit this line, because a real Firebase build needs it.
google-services.json

# Outlined brand assets are generated by brand/outline.sh, not authored
brand/svg/outlined/

# Generated by flutter gen-l10n for the translation gate; never committed
lib/l10n/untranslated.txt

# CI's secret scan downloads this binary into the tree; keep it out of git
# and out of reuse lint
/gitleaks
